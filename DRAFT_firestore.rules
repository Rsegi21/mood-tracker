rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    // Phase 3: Primitive Definition
    function isValidId(id) { 
      // Allow YYYY-MM-DD format and specific lengths
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    // Validation Blueprint for MoodEntry
    function isValidMoodEntry(data) {
      return data.keys().hasAll(['emoji', 'energia', 'timestamp'])
        && (!data.keys().hasAny(['nota']) || data.nota is string)
        && (!data.keys().hasAny(['palabra']) || data.palabra is string)
        && data.emoji is string && data.emoji.size() <= 15
        && data.energia is string && data.energia.size() <= 10
        && data.timestamp is number;
    }

    // Moods subcollection under User Space
    match /usuarios/{userId}/moods/{dateId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      
      allow create: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(dateId)
        && isValidMoodEntry(incoming());
        
      allow update: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(dateId)
        && isValidMoodEntry(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['emoji', 'nota', 'energia', 'palabra', 'timestamp']);
        
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
